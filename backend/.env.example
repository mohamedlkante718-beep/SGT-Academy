# Copiez ce fichier en .env et remplissez vos propres valeurs.
# Ne JAMAIS committer le fichier .env réel (voir .gitignore).

DJANGO_ENV=dev
SECRET_KEY=change-me-generate-a-real-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# En local sans PostgreSQL installé, laissez DATABASE_URL vide : SQLite sera utilisé.
# En production (Railway), Railway fournit automatiquement cette variable.
DATABASE_URL=postgres://user:password@localhost:5432/sgt_academy

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

TIME_ZONE=Africa/Bamako
DEFAULT_CURRENCY=XOF

# Stockage objet S3-compatible (Cloudflare R2, Backblaze B2, AWS S3...) — production uniquement
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Prestataire de paiement (Mali/XOF) — à compléter une fois le contrat signé.
# Exemple pour CinetPay :
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
